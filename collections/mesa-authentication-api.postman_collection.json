      },
      "item": [
        {
          "id": "c1126beb-b458-4892-b3bc-884a6f87013e",
          "name": "Create a session token",
          "request": {
            "name": "Create a session token",
            "description": {
              "content": "Authenticate with your clientId and clientSecret and mint a short-lived JWT scoped to a single end user (vendorId + userId). Call this server-side only; never expose credentials to the browser. The returned token is passed to MesaClient.init() as jwtToken.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"vendorId\": \"<string>\",\n  \"userId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6ab73da2-a4da-442e-abd9-71034375475f",
              "name": "A signed JWT for the requested user session.",
